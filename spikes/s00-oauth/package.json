{
  "name": "@fortnox-mcp/s00-oauth-spike",
  "version": "0.0.0-experimental",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=10.9.2 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "tsx src/node.ts",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "build": "esbuild src/worker.ts --bundle --platform=browser --format=esm --target=es2022 --external:cloudflare:* --external:node:* --outfile=dist/worker.js",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.10",
    "@cfworker/json-schema": "4.1.1",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/server": "2.3.1",
    "better-auth": "1.7.10",
    "decimal.js": "10.6.0",
    "http-parser-js": "0.5.10",
    "ipaddr.js": "2.2.0",
    "jpeg-js": "0.4.4",
    "oauth4webapi": "3.8.8",
    "pdf-lib": "1.17.1",
    "pngjs": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261018.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.1-beta",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.151.1"
  }
}
