{
  "name": "fortnox-mcp-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=10.9.2 <12"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx apps/node/src/main.ts",
    "dev:docs": "node --env-file-if-exists=.env --import tsx apps/node/src/docs-main.ts",
    "dev:worker": "wrangler dev --config apps/worker/wrangler.jsonc --ip 127.0.0.1 --local",
    "dev:installation": "wrangler dev --config wrangler.jsonc --ip 127.0.0.1 --local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrate": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "deploy": "npm run db:migrate && wrangler deploy --config wrangler.jsonc",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.worker.json && tsc --project tsconfig.tests.json && tsc --project apps/admin/tsconfig.json",
    "format": "biome check --write .",
    "lint": "biome check .",
    "test": "npm run test:node && npm run test:worker",
    "test:node": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:integration": "node scripts/acceptance.mjs fortnox",
    "test:clients": "node scripts/acceptance.mjs clients",
    "test:accounting": "node scripts/accounting-acceptance.mjs reads",
    "test:accounting:record": "node scripts/accounting-acceptance.mjs record",
    "test:receipts:status": "node scripts/receipt-recovery-acceptance.mjs status",
    "test:receipts:record": "node scripts/receipt-recovery-acceptance.mjs record",
    "test:receipts:attachments": "node scripts/receipt-provider-acceptance.mjs",
    "build": "node scripts/build.mjs",
    "test:build": "node --disallow-code-generation-from-strings --test tests/build.test.mjs && node --test tests/product-worker-native.test.mjs",
    "dev:product": "node --env-file-if-exists=.env --import tsx apps/node/src/product-main.ts",
    "dev:receipt-relay": "node --import tsx scripts/serve-receipt-relay.ts",
    "dev:product:worker": "wrangler dev --config apps/worker/wrangler.product.jsonc --local --ip 127.0.0.1",
    "prepare:product:bootstrap": "node scripts/product-bootstrap.mjs",
    "prepare:product:recovery": "node --env-file-if-exists=.env --import tsx scripts/product-recovery.ts",
    "prepare:receipt-relay": "node --env-file-if-exists=.env --import tsx scripts/prepare-receipt-relay.ts"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "A database owned by your Cloudflare account. This test checks the schema only; Fortnox and remote MCP are disabled."
      }
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261018.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.1-beta",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "@better-auth/core": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "@better-fetch/fetch": "1.3.2",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/server": "2.3.1",
    "better-auth": "1.7.10",
    "better-call": "1.4.2",
    "hono": "4.13.17",
    "oauth4webapi": "3.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "@cloudflare/vitest-plugin": {
      "zod": "4.6.7"
    },
    "@better-auth/utils": "0.5.1",
    "undici": "7.30.1"
  }
}
