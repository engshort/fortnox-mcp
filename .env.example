# Product test installation. Copy to ignored .env and keep private permissions.
# Generate AUTH_SECRET and a 32-byte base64 encryption key locally; never reuse probe secrets.
PRODUCT_ENABLED=false
PUBLIC_ORIGIN=http://127.0.0.1:8787
PORT=8787
# Node only. Docker binds 0.0.0.0 internally and publishes loopback.
HOST=127.0.0.1
DATA_DIR=.data
# Optional explicit database path overrides DATA_DIR.
PRODUCT_DATABASE=.data/product.sqlite
# none for direct development; nginx only behind the documented proxy.
NODE_PROXY_MODE=none
# Node supports AUTH_SECRET_FILE, CREDENTIAL_KEYS_FILE and FORTNOX_CLIENT_SECRET_FILE.
# Do not set both a secret value and its corresponding _FILE variable.
AUTH_SECRET=
CREDENTIAL_ACTIVE_KEY=v1
CREDENTIAL_KEYS={"v1":"REPLACE_WITH_PRIVATE_32_BYTE_BASE64_KEY"}
MCP_REDIRECT_URIS=["https://chatgpt.com/connector_platform_oauth_redirect"]
FORTNOX_TEST_MODE=false
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
# Two distinct numeric sandbox tenant IDs, comma-separated. No production accounts.
FORTNOX_TEST_TENANTS=
ACCOUNTING_REFERENCES_ENABLED=false
# Only request inbox/connectfile in a NEW owner-initiated test consent.
# Requires test mode and accounting reference consent; enables no file/write tool.
FORTNOX_RECEIPT_CONSENT=false
# Optional short-lived file transport preparation for an allowlisted test install.
# These settings do not enable file tools, provider writes or accepted host gates.
# node-direct is Node-only. Worker accepts only explicitly selected node-relay.
RECEIPT_FILE_TRANSPORT=none
RECEIPT_FILE_ORIGINS=
RECEIPT_FILE_RELAY_ORIGIN=
# Independent 64-hex session secret; use a Worker secret, never a public var.
RECEIPT_FILE_RELAY_TOKEN=
# UTC ISO timestamp at most 15 minutes ahead; helper/Worker must use the same value.
RECEIPT_FILE_RELAY_UNTIL=
