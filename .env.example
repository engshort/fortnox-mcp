# Product installation. Copy to ignored .env and keep private permissions.
# Generate AUTH_SECRET and a 32-byte base64 encryption key locally; never reuse probe secrets.
PUBLIC_ORIGIN=http://127.0.0.1:8787
PORT=8787
# Node only. Docker binds 0.0.0.0 internally and publishes loopback.
HOST=127.0.0.1
DATA_DIR=.data
# Optional explicit database path overrides DATA_DIR.
PRODUCT_DATABASE=.data/product.sqlite
# none for direct development; nginx only behind the documented proxy.
NODE_PROXY_MODE=none
# Node supports AUTH_SECRET_FILE, CREDENTIAL_KEYS_FILE and FORTNOX_CLIENT_SECRET_FILE.
# Do not set both a secret value and its corresponding _FILE variable.
AUTH_SECRET=
CREDENTIAL_ACTIVE_KEY=v1
CREDENTIAL_KEYS={"v1":"REPLACE_WITH_PRIVATE_32_BYTE_BASE64_KEY"}
MCP_REDIRECT_URIS=["https://chatgpt.com/connector_platform_oauth_redirect"]
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
# Optional read-only REST transport; existing company/program policy still applies.
REST_API_ENABLED=false
# Generic catalogue-driven Fortnox bridge. Requires REST_API_ENABLED and explicit
# OAuth bridge/write/file consent. Install a privately reviewed catalogue as the owner.
REST_BRIDGE_ENABLED=false
REST_SYNC_ENABLED=false
FORTNOX_EVENTS_ENABLED=false
# New raw financial reads only; leave empty outside explicitly authorized tests.
# Modules: customer_invoices,supplier_invoices,vouchers,accounts.
FINANCIAL_READ_MODULES=
FORTNOX_TEST_MODE=false
# Two distinct numeric test tenant IDs; used only for the opted-in raw reads.
FORTNOX_TEST_TENANTS=
# Optional account emails. Use an address on a verified Resend domain.
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
# Node also supports RESEND_API_KEY_FILE, mutually exclusive with RESEND_API_KEY.
# File input transport and exact approved source origins.
# node-direct is Node-only. Worker accepts only explicitly selected node-relay.
RECEIPT_FILE_TRANSPORT=node-direct
RECEIPT_FILE_ORIGINS=
RECEIPT_FILE_RELAY_ORIGIN=
# Independent 64-hex session secret; use a Worker secret, never a public var.
RECEIPT_FILE_RELAY_TOKEN=
# UTC ISO timestamp at most 15 minutes ahead; helper/Worker must use the same value.
RECEIPT_FILE_RELAY_UNTIL=

# Optional read-only analysis modules, disabled until explicitly configured.
FINANCIAL_ANALYSIS_CONTEXTS_ENABLED=false
FINANCIAL_LARGE_READS_ENABLED=false

# Optional team access and backend membership provisioning (both default off).
MULTI_USER_ENABLED=false
MEMBERSHIP_PROVISIONING_ENABLED=false

# Optional confidential-backend company onboarding; does not restrict ordinary MCP clients.
EXTERNAL_APP_ONBOARDING_ENABLED=false
EXTERNAL_APP_ONBOARDING_CLIENT_IDS=[]
# Optional 30-day rolling offline access for explicitly registered confidential backends.
# Requires existing offline_access consent; ordinary clients retain 24-hour refresh tokens.
MCP_OFFLINE_CLIENT_IDS=[]
